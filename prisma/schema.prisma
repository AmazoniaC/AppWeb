// Esquema base del ERP de Amazonia Concrete.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Usuarios y acceso ──────────────────────────────────────────────

enum Rol {
  ADMIN
  VENTAS
  PLANTA
  CONDUCTOR
}

model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  passwordHash  String   @map("password_hash")
  rol           Rol
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  pedidosCreados Pedido[]      @relation("PedidoCreadoPor")
  despachos      Despacho[]    @relation("DespachoConductor")
  vehiculo       Vehiculo?
  clientes       Cliente[]     @relation("ClienteAsesor")
  seguimientos   Seguimiento[] @relation("SeguimientoUsuario")

  @@map("usuarios")
}

// ─── Comercial ──────────────────────────────────────────────────────

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum TipoDocumento {
  NIT
  CC
  CE
  PASAPORTE
}

// PROSPECTO: aún no compra; ACTIVO: cliente vigente; INACTIVO: ya no se le vende.
enum EstadoCliente {
  PROSPECTO
  ACTIVO
  INACTIVO
}

model Cliente {
  id              String        @id @default(cuid())
  tipoPersona     TipoPersona   @default(JURIDICA) @map("tipo_persona")
  tipoDocumento   TipoDocumento @default(NIT) @map("tipo_documento")
  documento       String        @unique // NIT o cédula
  nombre          String // Razón social o nombre completo
  nombreComercial String?       @map("nombre_comercial")
  telefono        String?
  whatsapp        String? // Celular para WhatsApp; si falta se usa el teléfono
  email           String?
  direccion       String?
  ciudad          String?
  contactoNombre  String?       @map("contacto_nombre")
  contactoCargo   String?       @map("contacto_cargo")
  estado          EstadoCliente @default(ACTIVO)
  // Condiciones comerciales que usarán cotizaciones, ventas y cartera.
  plazoPagoDias   Int           @default(0) @map("plazo_pago_dias") // 0 = contado
  cupoCredito     Decimal?      @map("cupo_credito") @db.Decimal(14, 2)
  notas           String?
  asesorId        String?       @map("asesor_id")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt @map("actualizado_en")

  asesor       Usuario?      @relation("ClienteAsesor", fields: [asesorId], references: [id])
  obras        Obra[]
  pedidos      Pedido[]
  seguimientos Seguimiento[]

  @@index([estado])
  @@index([asesorId])
  @@map("clientes")
}

enum TipoSeguimiento {
  LLAMADA
  WHATSAPP
  VISITA
  CORREO
  REUNION
  NOTA
}

// Historial de contacto con el cliente. Si trae proximaFecha es una tarea
// pendiente hasta que se marque completada.
model Seguimiento {
  id            String          @id @default(cuid())
  clienteId     String          @map("cliente_id")
  usuarioId     String          @map("usuario_id")
  tipo          TipoSeguimiento
  descripcion   String
  proximaAccion String?         @map("proxima_accion")
  proximaFecha  DateTime?       @map("proxima_fecha")
  completadoEn  DateTime?       @map("completado_en")
  creadoEn      DateTime        @default(now()) @map("creado_en")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario Usuario @relation("SeguimientoUsuario", fields: [usuarioId], references: [id])

  @@index([clienteId, creadoEn])
  @@index([proximaFecha])
  @@map("seguimientos")
}

model Obra {
  id            String   @id @default(cuid())
  clienteId     String   @map("cliente_id")
  nombre        String
  direccion     String
  ciudad        String?
  contacto      String?
  telefono      String?
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  pedidos Pedido[]

  @@index([clienteId])
  @@map("obras")
}

// Diseño de mezcla / tipo de concreto que se vende.
model Producto {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombre         String
  resistenciaPsi Int?     @map("resistencia_psi")
  asentamientoCm Decimal? @map("asentamiento_cm") @db.Decimal(5, 1)
  precioM3       Decimal  @map("precio_m3") @db.Decimal(12, 2)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")

  pedidos Pedido[]

  @@map("productos")
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  EN_PRODUCCION
  DESPACHADO
  ENTREGADO
  CANCELADO
}

model Pedido {
  id            String       @id @default(cuid())
  numero        Int          @unique @default(autoincrement())
  clienteId     String       @map("cliente_id")
  obraId        String       @map("obra_id")
  productoId    String       @map("producto_id")
  volumenM3     Decimal      @map("volumen_m3") @db.Decimal(8, 2)
  precioM3      Decimal      @map("precio_m3") @db.Decimal(12, 2)
  fechaEntrega  DateTime     @map("fecha_entrega")
  estado        EstadoPedido @default(PENDIENTE)
  notas         String?
  creadoPorId   String       @map("creado_por_id")
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  obra      Obra       @relation(fields: [obraId], references: [id])
  producto  Producto   @relation(fields: [productoId], references: [id])
  creadoPor Usuario    @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id])
  despachos Despacho[]

  @@index([clienteId])
  @@index([fechaEntrega])
  @@index([estado])
  @@map("pedidos")
}

// ─── Operación: planta y flota ──────────────────────────────────────

model Vehiculo {
  id                  String   @id @default(cuid())
  placa               String   @unique
  descripcion         String?
  capacidadM3         Decimal  @map("capacidad_m3") @db.Decimal(5, 2)
  conductorAsignadoId String?  @unique @map("conductor_asignado_id")
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now()) @map("creado_en")
  actualizadoEn       DateTime @updatedAt @map("actualizado_en")

  conductorAsignado Usuario?   @relation(fields: [conductorAsignadoId], references: [id])
  despachos         Despacho[]

  @@map("vehiculos")
}

enum EstadoDespacho {
  PROGRAMADO
  CARGANDO
  EN_RUTA
  EN_OBRA
  ENTREGADO
  CANCELADO
}

// Cada viaje de un mixer hacia la obra (remisión).
model Despacho {
  id            String         @id @default(cuid())
  numero        Int            @unique @default(autoincrement())
  pedidoId      String         @map("pedido_id")
  vehiculoId    String         @map("vehiculo_id")
  conductorId   String         @map("conductor_id")
  volumenM3     Decimal        @map("volumen_m3") @db.Decimal(6, 2)
  estado        EstadoDespacho @default(PROGRAMADO)
  horaSalida    DateTime?      @map("hora_salida")
  horaLlegada   DateTime?      @map("hora_llegada")
  horaEntrega   DateTime?      @map("hora_entrega")
  notas         String?
  creadoEn      DateTime       @default(now()) @map("creado_en")
  actualizadoEn DateTime       @updatedAt @map("actualizado_en")

  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id])
  conductor Usuario  @relation("DespachoConductor", fields: [conductorId], references: [id])

  @@index([pedidoId])
  @@index([conductorId])
  @@index([estado])
  @@map("despachos")
}

// ─── Configuración de la empresa ────────────────────────────────────

// Una sola fila (id "general") con la marca que se muestra en la app.
// El logo se guarda en la base de datos para no depender de carpetas del equipo.
model Configuracion {
  id            String   @id @default("general")
  logo          Bytes?
  logoTipo      String?  @map("logo_tipo") // image/png, image/jpeg o image/webp
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion")
}
