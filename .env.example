# Conexión a PostgreSQL. Con Neon, pega aquí la cadena que copias en "Connect" (ver README).
DATABASE_URL="postgresql://amazonia:amazonia@localhost:5432/amazonia_erp?schema=public"

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
